# Local environments, builds and secrets
/.venv/
/.runtime/
/.cache/
**/node_modules/
**/.next/
**/__pycache__/
*.py[cod]
*.tsbuildinfo
*.log
*.part
*.crc
.env
.env.*
!.env.example
.streamlit/secrets.toml
.DS_Store
Thumbs.db

# Large research data stays local; keep pinned metadata and geography.
/data/raw/*
!/data/raw/geography/
!/data/raw/oceanng/
/data/raw/oceanng/*
!/data/raw/oceanng/manifest.json
!/data/raw/oceanng/DATASET_CARD.md
/data/processed/*
!/data/processed/core_v1/
/data/processed/core_v1/*
!/data/processed/core_v1/manifest.json
!/data/processed/core_v1/excluded_review_ids.json

# Small real runtime artifacts travel with every clone.
/artifacts/*
!/artifacts/models/
/artifacts/models/*
!/artifacts/models/v1/
!/artifacts/market/
!/artifacts/geography/
!/artifacts/etl/
!/artifacts/figures/
!/artifacts/verification/
/artifacts/verification/*
!/artifacts/verification/api_checks.json
!/artifacts/verification/product_features_api.json
!/artifacts/verification/ui-ux-v4/
!/artifacts/verification/github-clone/
!/artifacts/verification/product-v5/

# Local submission ZIPs / Office snapshots, not needed to run the web.
/deliverables/*
!/deliverables/README.md

# JVM diagnostics generated by a failed local process
*.hprof
*.dmp
